{
  "display_information": {
    "name": "Contentful Palmata Ops (local)",
    "description": "Manage Contentful content and research Palmata insights from Slack."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Contentful Ops Bot (local)",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/connect",
        "url": "https://ctfl-palmata-ops-slack-bot-main.vercel.app//api/webhooks/slack",
        "description": "Connect Contentful and Palmata to this workspace.",
        "should_escape": false
      },
      {
        "command": "/disconnect",
        "url": "https://ctfl-palmata-ops-slack-bot-main.vercel.app//api/webhooks/slack",
        "description": "Disconnect Contentful and Palmata from this workspace.",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "commands",
        "files:read",
        "groups:history",
        "groups:read",
        "reactions:read",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": false,
    "org_deploy_enabled": false,
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://ctfl-palmata-ops-slack-bot-main.vercel.app//api/webhooks/slack"
    },
    "event_subscriptions": {
      "request_url": "https://referee-undiluted-item.ngrok-free.dev/slack/events",
      "bot_events": [
        "app_home_opened",
        "app_mention",
        "message.channels",
        "message.groups",
        "reaction_added",
        "reaction_removed"
      ]
    },
    "token_rotation_enabled": false,
    "app_level_token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
